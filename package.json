{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=4321 && (lsof -ti:$PORT | xargs kill -9 2>/dev/null || true) && sleep 1 && bun --bun astro dev --port $PORT",
    "start": "bun --bun astro preview",
    "build": "bun --bun astro build",
    "check": "bun --bun astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.3.1",
    "@astrojs/tailwind": "^6.0.2",
    "@google/genai": "^1.20.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "add": "^2.0.6",
    "astro": "^5.13.11",
    "bun": "^1.2.22",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9"
  }
}
