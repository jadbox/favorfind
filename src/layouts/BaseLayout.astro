---
import Header from "../components/Header";
import Sidebar from "../components/Sidebar";
import Disclaimer from "../components/Disclaimer";
import LoadingOverlay from "../components/LoadingOverlay.astro";
import "../index.css";

export interface Props {
  title?: string;
}

const { title = "Medeligo Cancer Research" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/images/Mark-2.ico" />
    <link rel="shortcut icon" href="/images/Mark-2.ico" />
    <link rel="apple-touch-icon" href="/assets/images/Logo-2-scaled.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-gray-50 flex flex-col">
      <Header client:load />

      <div class="flex flex-1 flex-col-reverse md:flex-row">
        <Sidebar client:load />

        <main class="flex-1 flex flex-col">
          <slot />
        </main>
      </div>

      <Disclaimer client:load />
      <LoadingOverlay />
    </div>

    <script>
      import { LoadingUtils } from "../utils/loadingUtils";

      document.addEventListener("DOMContentLoaded", () => {
        LoadingUtils.initializeForPage();
      });
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WP3XFJBXJS"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());

      gtag("config", "G-WP3XFJBXJS");
    </script>
  </body>
</html>
