---
import Header from "../components/Header";
import Sidebar from "../components/Sidebar";
import Disclaimer from "../components/Disclaimer";
import LoadingOverlay from "../components/LoadingOverlay.astro";
import "../index.css";

export interface Props {
  title?: string;
}

const { title = "FavorFind" } = Astro.props;

// Pages that should have a minimal layout (no header, sidebar, etc.)
const minimalLayoutPages = ["/terms", "/privacy"];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"; // Normalize path
const isMinimalLayout = minimalLayoutPages.includes(currentPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/ff-logo-nowords.png" />

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Find the very best with AI-powered search"
    />
    <meta property="og:image" content="/images/favorfind-logo.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="Find the very best with AI-powered search"
    />
    <meta name="twitter:image" content="/images/favorfind-logo.png" />

    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      {!isMinimalLayout && <Header client:load />}

      <div
        class:list={[
          "flex flex-1",
          { "flex-col-reverse md:flex-row": !isMinimalLayout },
        ]}
      >
        {!isMinimalLayout && <Sidebar client:load />}

        <main class="flex-1 flex flex-col">
          <slot />
        </main>
      </div>

      {!isMinimalLayout && <Disclaimer client:load />}
      <LoadingOverlay />
    </div>

    <script>
      import { LoadingUtils } from "../utils/loadingUtils";

      let cleanup: () => void;

      function initialize() {
        if (cleanup) {
          cleanup();
        }
        cleanup = LoadingUtils.initializeForPage();
      }

      // Initialize on initial page load
      initialize();

      // Re-initialize after every Astro navigation
      document.addEventListener("astro:page-load", initialize);
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WP3XFJBXJS"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());

      gtag("config", "G-STJLGFMVYL");
    </script>
  </body>
</html>
