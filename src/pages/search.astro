---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar";
import SearchResultsFilters from "../components/SearchResultsFilters";
import { ArrowLeft } from "lucide-react";
import type { SearchResult, SearchHistory } from "../types";
import { fetchSearchResults } from "../api/search";

// Get query parameter from URL
const url = new URL(Astro.request.url);
const query = url.searchParams.get("q")?.trim() || "";
const selectedType =
  url.searchParams.get("filter_type") || "Guidelines (Default)";
const primaryTumorSite = url.searchParams.get("primaryTumorSite") || "All";
const ageGroup = url.searchParams.get("ageGroup") || "All";
const gender = url.searchParams.get("gender") || "All";
const sortBy = url.searchParams.get("sortBy") || "relevance";

// Fetch search results if query exists
let results: SearchResult[] = [];
let error: string | null = null;
const limit = parseInt(url.searchParams.get("limit") || "0");

const filterParams = [
  selectedType,
  primaryTumorSite !== "All" && primaryTumorSite,
  ageGroup !== "All" && ageGroup,
  gender !== "All" && gender,
]
  .filter(Boolean)
  .join(",");

if (query) {
  try {
    console.log(
      "Server-side search for:",
      query,
      "limit:",
      limit,
      "filters:",
      filterParams
    );
    results = await fetchSearchResults(query, limit, 1, filterParams);
    console.log("Server-side results:", results.length);
  } catch (err) {
    console.error("Search error:", err);
    error = err instanceof Error ? err.message : "Search failed";
  }
}

// For now, we'll use empty data for other fields
const searchHistory: SearchHistory[] = [];

const title = query ? `Results for "${query}"` : "Search";
---

<BaseLayout title={title} searchHistory={searchHistory}>
  <div class="flex-1 p-6">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6">
        <a
          href="/"
          class="btn btn-sm btn-ghost text-gray-600 hover:text-gray-900 mr-4 inline-flex items-center"
        >
          <ArrowLeft className="h-4 w-4 mr-2" />
          Back to Home
        </a>
        <div class="flex-1 mt-4">
          <SearchBar query={query} />
        </div>
      </div>

      {
        query && (
          <div class="mb-6">
            <SearchResultsFilters
              selectedType={selectedType}
              primaryTumorSite={primaryTumorSite}
              ageGroup={ageGroup}
              gender={gender}
              sortBy={sortBy as any}
              client:only="react"
            />
          </div>
        )
      }

      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-gray-900">
          {query ? `Search Results for "${query}"` : "Search"}
        </h2>
        <div class="text-sm text-gray-600">
          {results.length} results
        </div>
      </div>

      {
        error && (
          <div class="alert alert-error mb-4">
            <span>{error}</span>
          </div>
        )
      }

      {/* Loading overlay */}
      <div
        id="loading-overlay"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 opacity-0 pointer-events-none transition-opacity duration-200"
      >
        <div class="bg-white rounded-lg p-6 flex items-center space-x-4">
          <div
            class="animate-spin rounded-full h-8 w-8 border-b-2 border-medical-600"
          >
          </div>
          <span class="text-gray-700">Loading...</span>
        </div>
      </div>

      {
        query ? (
          <div class="grid gap-6">
            {results.length === 0 ? (
              <div class="text-center py-12 text-gray-500">
                No results found
              </div>
            ) : (
              results.map((result) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                  <div class="flex justify-between items-start mb-3">
                    <h3 class="text-lg font-semibold text-gray-900 leading-tight">
                      <a
                        href={result.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-medical-600"
                      >
                        {result.title}
                      </a>
                    </h3>
                  </div>

                  <div class="text-sm text-gray-600 mb-3">
                    {result.publisher} • {result.publicationDate} •{" "}
                    {result.citationCount} citations
                  </div>

                  <p class="text-gray-700 text-sm leading-relaxed mb-4">
                    {result.abstract}
                  </p>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-medical-100 text-medical-800">
                        {result.type}
                      </span>
                    </div>

                    <a
                      href={result.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-medical-600 hover:text-medical-700 text-sm font-medium"
                    >
                      View Article →
                    </a>
                  </div>
                </div>
              ))
            )}
          </div>
        ) : (
          <div class="text-center py-12 text-gray-500">
            Enter a search query to get started
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // Show loading overlay when forms are submitted or filters are updated
  function showLoading() {
    const overlay = document.getElementById("loading-overlay");
    if (overlay) {
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
    }
  }

  // Hide loading overlay
  function hideLoading() {
    const overlay = document.getElementById("loading-overlay");
    if (overlay) {
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      overlay.classList.add("opacity-0", "pointer-events-none");
    }
  }

  // Add loading to search form submission
  document.addEventListener("DOMContentLoaded", () => {
    const searchForm = document.querySelector('form[action="/search"]');
    if (searchForm) {
      searchForm.addEventListener("submit", showLoading);
    }

    // Listen for filter updates (when URL changes)
    let currentUrl = window.location.href;
    const observer = new MutationObserver(() => {
      if (window.location.href !== currentUrl) {
        currentUrl = window.location.href;
        showLoading();
      }
    });

    // Observe changes to the body or a specific element
    observer.observe(document.body, { childList: true, subtree: true });

    // Also listen for popstate events (back/forward navigation)
    window.addEventListener("popstate", showLoading);

    // Hide loading when page is fully loaded
    window.addEventListener("load", hideLoading);
  });
</script>
