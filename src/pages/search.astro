---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar";
import SearchResultCard from "../components/SearchResultCard";
import { ArrowLeft } from "lucide-react";
import type { SearchResult, SearchHistory } from "../types";

// Get query parameter from URL
const url = new URL(Astro.request.url);
const query = url.searchParams.get("q")?.trim() || "";

// For now, we'll use empty data - this will be replaced with proper server-side data fetching
const results: SearchResult[] = [];
const searchHistory: SearchHistory[] = [];
const savedIds: string[] = [];

const title = query ? `Results for "${query}"` : "Search";
---

<BaseLayout title={title} searchHistory={searchHistory}>
  <div class="flex-1 p-6">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6">
        <a
          href="/"
          class="btn btn-sm btn-ghost text-gray-600 hover:text-gray-900 mr-4 inline-flex items-center"
        >
          <ArrowLeft className="h-4 w-4 mr-2" />
          Back to Home
        </a>
        <div class="flex-1 mt-4">
          <SearchBar query={query} client:load />
        </div>
      </div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-gray-900">
          Search Results for "{query}"
        </h2>
        <div class="text-sm text-gray-600">
          {results.length} results
        </div>
      </div>
      <div class="grid gap-4">
        {
          results.length === 0 ? (
            <div class="text-center py-12 text-gray-500">
              {query
                ? "No results found"
                : "Enter a search query to get started"}
            </div>
          ) : (
            results.map((result) => (
              <SearchResultCard
                result={result}
                isSaved={savedIds.includes(result.id)}
                returnTo={`/search?q=${encodeURIComponent(query)}`}
                client:load
              />
            ))
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
