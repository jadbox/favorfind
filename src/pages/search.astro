---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar.tsx";
import SearchResultsDisplay from "../components/SearchResultsDisplay.tsx";
import SearchResultsFilters from "../components/SearchResultsFilters.tsx";
import {
  parseSearchParams,
  performSearch,
  checkSavedStatus,
} from "../utils/searchHelpers";
import { readUserDataCookie } from "../CookieUserData";

// Parse search parameters
const searchParams = parseSearchParams(new URL(Astro.request.url));

// Perform server-side search
const searchData = await performSearch(
  searchParams,
  Astro.request.headers.get("cookie"),
  (cookie: string) => {
    Astro.response.headers.set("Set-Cookie", cookie);
  }
);

// Check saved status for results
const savedStatus = await checkSavedStatus(
  searchData.results,
  new URL(Astro.request.url).origin,
  Astro.request.headers.get("cookie")
);

// Get user data for sidebar
const userData = readUserDataCookie(Astro.request.headers.get("cookie"));
---

<BaseLayout title="Search Results" searchHistory={userData.searchHistory}>
  <div class="flex-1 flex overflow-hidden">
    <!-- Search Results Area -->
    <main class="flex-1 flex flex-col p-4 overflow-hidden">
      <SearchBar client:load query={searchParams.query} />

      <div class="mb-4">
        <SearchResultsFilters
          client:load
          selectedType={searchParams.selectedType}
          primaryTumorSite={searchParams.primaryTumorSite}
          ageGroup={searchParams.ageGroup}
          gender={searchParams.gender}
          sortBy={searchParams.sortBy as "relevance" | "date" | "citations"}
        />
      </div>

      <div class="flex-1 overflow-auto">
        {
          searchData.error ? (
            <div class="alert alert-error">
              <span>{searchData.error}</span>
            </div>
          ) : (
            <SearchResultsDisplay
              client:load
              loading={false}
              filteredResults={searchData.results}
              savedIds={Object.keys(savedStatus).filter(
                (id) => savedStatus[id]
              )}
            />
          )
        }
      </div>
    </main>
  </div>
</BaseLayout>
