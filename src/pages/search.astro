---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar.tsx";
import SearchResultsDisplay from "../components/SearchResultsDisplay.tsx";
import SearchResultsFilters from "../components/SearchResultsFilters.tsx";
import {
  parseSearchParams,
  performSearch,
} from "../utils/searchHelpers.server";

// Parse search parameters
const searchParams = parseSearchParams(new URL(Astro.request.url));

// Perform server-side search
const searchData = await performSearch(searchParams);
---

<BaseLayout title="Search Results">
  <div class="flex-1 flex overflow-hidden">
    <!-- Search Results Area -->
    <main class="flex-1 flex flex-col p-4 overflow-hidden">
      <SearchBar client:load query={searchParams.query} />

      <!-- <div class="mb-4">
        <SearchResultsFilters
          client:load
          contentType={searchParams.selectedType}
          sourceType={"All"}
          datePublished={"any"}
          sortBy={searchParams.sortBy as "relevance" | "date" | "popular"}
        />
      </div> -->

      <div class="flex-1 overflow-auto">
        {
          searchData.error ? (
            <div class="alert alert-error">
              <span>{searchData.error}</span>
            </div>
          ) : (
            <SearchResultsDisplay
              client:load
              loading={false}
              filteredResults={searchData.results}
            />
          )
        }
      </div>
    </main>
  </div>

  <script>
    import {
      saveSearchToHistory,
      parseSearchParams,
    } from "../utils/searchHelpers.client";

    // Save search to history when page loads (client-side)
    document.addEventListener("DOMContentLoaded", () => {
      const url = new URL(window.location.href);
      const params = parseSearchParams(url);

      if (params.query) {
        // Get the results count from the page
        const resultsContainer = document.querySelector("[data-results-count]");
        const resultsCount = resultsContainer
          ? parseInt(
              resultsContainer.getAttribute("data-results-count") || "0",
              10
            )
          : 0;

        saveSearchToHistory(params, resultsCount);

        // Dispatch event to update sidebar
        window.dispatchEvent(new CustomEvent("search-history-updated"));
      }
    });
  </script>
</BaseLayout>
