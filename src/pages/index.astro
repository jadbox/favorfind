---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar";
import type { SearchHistory } from "../types";
import { readUserDataCookie } from "../CookieUserData";
// import { ClientRouter } from "astro:transitions";
// In Astro, we'll need to get search history from server-side data
const userData = readUserDataCookie(Astro.request.headers.get("cookie"));
const searchHistory: SearchHistory[] = userData.searchHistory;
---

<BaseLayout title="Medeligo Cancer Research" searchHistory={searchHistory}>
  <!-- <ClientRouter /> -->
  <div class="flex-1 flex flex-col items-center justify-center p-6">
    <div class="max-w-4xl w-full">
      <div class="text-center mb-12">
        <h1 class="text-5xl font-bold text-gray-900 mb-4">
          Welcome to Medeligo Research.
        </h1>
        <h2 class="text-2xl text-gray-600 font-medium">
          What do you want to search today?
        </h2>
      </div>
      <SearchBar />
    </div>
  </div>
</BaseLayout>
