---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar";
import type { SearchHistory } from "../types";
import { readUserDataCookie } from "../CookieUserData";
import { ClientRouter } from "astro:transitions";
// In Astro, we'll need to get search history from server-side data
const userData = readUserDataCookie(Astro.request.headers.get("cookie"));
const searchHistory: SearchHistory[] = userData.searchHistory;
---

<BaseLayout title="Medeligo Cancer Research" searchHistory={searchHistory}>
  <ClientRouter />
  <div class="flex-1 flex flex-col items-center justify-center p-6">
    <div class="max-w-4xl w-full">
      <div class="text-center mb-12">
        <h1 class="text-5xl font-bold text-gray-900 mb-4">
          Welcome to Medeligo Research.
        </h1>
        <h2 class="text-2xl text-gray-600 font-medium">
          What do you want to search today?
        </h2>
      </div>
      <SearchBar />
    </div>
  </div>

  {/* Loading overlay */}
  <div
    id="loading-overlay"
    class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 opacity-0 pointer-events-none transition-opacity duration-200"
    transition:persist
  >
    <div class="bg-white rounded-lg p-6 flex items-center space-x-4">
      <div
        class="animate-spin rounded-full h-8 w-8 border-b-2 border-medical-600"
      >
      </div>
      <span class="text-gray-700">Loading...</span>
    </div>
  </div>
</BaseLayout>

<script>
  // Show loading overlay
  function showLoading() {
    const overlay = document.getElementById("loading-overlay");
    if (overlay) {
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
    }
  }

  // Hide loading overlay
  function hideLoading() {
    const overlay = document.getElementById("loading-overlay");
    if (overlay) {
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      overlay.classList.add("opacity-0", "pointer-events-none");
    }
  }

  // Initialize page functionality
  document.addEventListener("DOMContentLoaded", () => {
    // Only show loading for search form submissions
    const searchForm = document.querySelector(
      'form[action="/search"]'
    ) as HTMLFormElement;
    if (searchForm) {
      searchForm.addEventListener("submit", (event) => {
        // Only show loading if the form has a non-empty query
        // const formData = new FormData(searchForm);
        // const query = formData.get("q")?.toString().trim();
        // if (query) {
        showLoading();
        //}
      });
    }

    // Hide loading when navigating back to this page
    document.addEventListener("astro:after-swap", hideLoading);

    // Ensure loading is hidden on page load
    window.addEventListener("load", hideLoading);
  });
</script>
