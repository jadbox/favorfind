---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar";
import DisclaimerModal from "../components/DisclaimerModal";
---

<BaseLayout title="FavorFind Cancer Research"
  ><div class="flex-1 flex flex-col items-center justify-center p-2 md:p-6">
    <!-- <DisclaimerModal client:load /> -->
    <div class="max-w-4xl w-full">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Welcome to <span class="text-primary">FavorFind</span>
        </h1>
        <h2 class="text-xl md:text-2xl text-text-secondary font-normal">
          What do you want to search today?
        </h2>
      </div>
      <SearchBar />
    </div>
  </div>
</BaseLayout>
